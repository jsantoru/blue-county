{
  "name": "blue-county",
  "version": "0.1.0",
  "description": "Local Warwick arcade racing with the 1968 Oldsmobile 442",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "map": "python scripts/map-build.py",
    "export-car": "powershell -ExecutionPolicy Bypass -File scripts/export-car.ps1",
    "export-club-cars": "powershell -ExecutionPolicy Bypass -File scripts/build-club-cars.ps1",
    "export-driver": "powershell -ExecutionPolicy Bypass -File scripts/build-hero-assets.ps1 -Asset driver",
    "export-home-props": "powershell -ExecutionPolicy Bypass -File scripts/build-hero-assets.ps1 -Asset home",
    "test:hero": "node scripts/hero-check.mjs",
    "test:hero-visual": "node scripts/hero-visual-pass.mjs --after",
    "test:club": "node scripts/test-club-garage.mjs",
    "test:buick-reference": "node scripts/buick-reference-check.mjs --after",
    "test:walking-facing": "node scripts/walking-facing-check.mjs",
    "test:controller-transitions": "node scripts/controller-transition-check.mjs",
    "test:camera-controls": "node scripts/camera-controls-check.mjs",
    "test:controller-drift": "node scripts/controller-drift-check.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:visual": "node scripts/visual-check.mjs",
    "test:beverly": "node scripts/beverly-check.mjs",
    "test:detail": "node scripts/beverly-check.mjs --detail-pass",
    "test:property": "node scripts/property-check.mjs",
    "test:home": "node scripts/home-check.mjs",
    "test:backyard": "node scripts/backyard-check.mjs",
    "test:exploration": "node scripts/exploration-check.mjs",
    "test:exploration:second": "node scripts/exploration-check.mjs --second-pass",
    "format": "prettier --write src tests index.html scripts/browser-check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "type": "module",
  "private": true
}
